# API keys
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# Video export quality
# Lower CRF means higher image quality and larger files. Good range: 16-20.
VIDEO_CRF=17
VIDEO_PRESET=slow
VIDEO_FPS=30
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_ENFORCE_16_9=1
VIDEO_THREADS=4
VIDEO_LAYOUT_MODE=cinematic
VIDEO_MAX_SHOT_DURATION=3.35
VIDEO_MIN_SHOT_DURATION=2.35
VIDEO_TRANSITION_STYLE=cut
VIDEO_CULTURE_LABELS=1
AUDIO_BITRATE=192k
BGM_VOLUME=0.12
VOICE_VOLUME=1.08
VOICEOVER_RATE=+18%

# Leave VIDEO_BITRATE empty to use CRF quality mode.
# Set it only if you need a fixed bitrate, for example 14000k.
VIDEO_BITRATE=

# Auto color/contrast/sharpness pass for source photos.
VIDEO_AUTO_ENHANCE=1
VIDEO_COLOR=1.08
VIDEO_CONTRAST=1.06
VIDEO_BRIGHTNESS=1.01
VIDEO_SHARPNESS=1.04
VIDEO_FRAME_COLOR=1.015
VIDEO_FRAME_CONTRAST=1.018
VIDEO_SAVE_CONTACT_SHEET=1
